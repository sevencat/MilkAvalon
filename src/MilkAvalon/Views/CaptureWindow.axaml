<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="MilkAvalon.Views.CaptureWindow"
        Title="抓取 Shadertoy 作品"
        Icon="/Assets/milkdropsharp.png"
        Width="1120" Height="780"
        MinWidth="820" MinHeight="560"
        Background="{DynamicResource MaterialBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        WindowDecorations="BorderOnly">

  <DockPanel>
    <!-- 自绘标题栏：系统标题栏由 DWM 画，浅色系统下是白条，和暗色主题对不上（同设置窗口） -->
    <Border DockPanel.Dock="Top" Name="CaptionBar"
            Background="{DynamicResource MaterialToolBarBackgroundBrush}"
            Padding="14,0,4,0"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="*,Auto" Height="36">
        <TextBlock Text="抓取 Shadertoy 作品" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="caption" Name="CloseButton" Content="✕"
                Click="OnCaptionCloseClick"
                chrome:WindowDecorationProperties.ElementRole="User" />
      </Grid>
    </Border>

    <!-- 地址栏：粘贴作品链接，回车或点「打开」即跳转；← → 是浏览历史 -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialToolBarBackgroundBrush}" Padding="12,3">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
        <Button Grid.Column="0" Classes="toolbar" Name="BackButton" Content="←" Height="28" Padding="8,0"
                Click="OnBackClick" IsEnabled="False" MinWidth="34" ToolTip.Tip="后退" />
        <Button Grid.Column="1" Classes="toolbar" Name="ForwardButton" Content="→" Height="28" Padding="8,0"
                Click="OnForwardClick" IsEnabled="False" MinWidth="34" ToolTip.Tip="前进" />

        <TextBox Grid.Column="2" Name="UrlBox" Height="28" FontSize="12" VerticalContentAlignment="Center"
                 PlaceholderText="https://www.shadertoy.com/view/flGyWc"
                 KeyDown="OnUrlKeyDown" />
        <Button Grid.Column="3" Classes="toolbar" Content="打开" Height="28" Padding="10,0"
                Click="OnOpenClick" MinWidth="60" FontSize="12" />

        <!-- 只在浏览器当前页是 /view/<id> 时可用：ID 直接从地址里取，不用手抄 -->
        <Button Grid.Column="4" Classes="toolbar" Name="GrabCurrentButton" Content="抓取当前页面"
                Click="OnGrabCurrentClick" Height="28" Padding="10,0" IsEnabled="False" MinWidth="104" FontSize="12"
                ToolTip.Tip="当前页面是 shadertoy.com/view/&lt;id&gt; 时可用，ID 自动取自地址栏" />
      </Grid>
    </Border>

    <!-- 状态栏：站点加载 / Cloudflare 等待 / 下载进度都写在这里 -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource MaterialToolBarBackgroundBrush}" Padding="12,6">
      <TextBlock Name="StatusText" Text="正在加载 shadertoy.com…" FontSize="12" Opacity="0.8"
                 TextWrapping="Wrap" />
    </Border>

    <!-- 内嵌浏览器（Windows 下是 WebView2）。登录态/Cloudflare 指纹靠持久化的用户数据目录 -->
    <wv:NativeWebView Name="Web" />
  </DockPanel>
</Window>
