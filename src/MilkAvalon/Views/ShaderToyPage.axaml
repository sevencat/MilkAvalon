<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MilkAvalon.Controls"
             xmlns:svc="using:MilkAvalon.Services"
             x:Class="MilkAvalon.Views.ShaderToyPage">

  <Grid Name="RootGrid" ColumnDefinitions="300,*">

    <!-- 左栏：作品库（数据根下 presets/*.shaderx 里的作品，作品就是文本） -->
    <Border Grid.Column="0" Name="LibraryPanel" Background="{DynamicResource MaterialPaperBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBox Name="SearchBox"
                 DockPanel.Dock="Top"
                 Margin="8,8,8,4"
                 PlaceholderText="{DynamicResource page.st.filter}"
                 TextChanged="OnSearchChanged" />

        <!-- buffer 分辨率三模式（Shadertoy 网页端的 viewport / fixed / scale 那三档） -->
        <!-- 初始选中项在代码里设：XAML 里写 SelectedIndex 会在控件还没构造完时触发 SelectionChanged -->
        <!-- 后两档会改 buffer 分辨率：作品若在 image pass 里用 iResolution 逐像素寻址 buffer
             （数据纹理 / 逐行存光之类），行列会错位，画面偏黑。网页端同样如此。 -->
        <ComboBox Name="BufferModeBox"
                  DockPanel.Dock="Top"
                  Margin="8,0,8,6"
                  ToolTip.Tip="{DynamicResource page.st.buffer.tip}"
                  SelectionChanged="OnBufferModeChanged">
          <ComboBoxItem Content="{DynamicResource page.st.buffer.viewport}" />
          <ComboBoxItem Content="{DynamicResource page.st.buffer.fixed}" />
          <ComboBoxItem Content="{DynamicResource page.st.buffer.half}" />
        </ComboBox>

        <TextBlock Name="LibraryText"
                   DockPanel.Dock="Bottom"
                   Margin="8,4,8,8"
                   FontSize="11"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   Text="{DynamicResource page.st.scanning}" />

        <ListBox Name="ShaderList"
                 Margin="4,0"
                 SelectionChanged="OnShaderSelected">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="svc:ShaderToyEntry">
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}"
                           ToolTip.Tip="{Binding Id}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Author}"
                           FontSize="11"
                           Opacity="0.6"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 右栏：GL 画面 + 底部信息条（pass / 错误都在这里） -->
    <DockPanel Grid.Column="1">
      <Border Name="InfoBar" DockPanel.Dock="Bottom" Background="{DynamicResource MaterialPaperBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}"
              BorderThickness="0,1,0,0" Padding="10,6">
        <StackPanel Classes="overlay" Spacing="1">
          <TextBlock Name="InfoShader" Text="{DynamicResource page.st.scanning}" />
          <TextBlock Name="InfoTime" />
          <TextBlock Name="InfoSize" />
          <TextBlock Name="InfoPass" />
          <TextBlock Name="InfoAudio" />
          <TextBlock Name="InfoWarning" Foreground="#FFAB40" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <controls:ShaderToyControl Name="ShaderToyView" />
    </DockPanel>

  </Grid>

</UserControl>
