<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MilkAvalon.Controls"
             xmlns:st="using:MilkDrop.ShaderToy.Import"
             x:Class="MilkAvalon.Views.ShaderToyPage">

  <Grid Name="RootGrid" ColumnDefinitions="300,*">

    <!-- 左栏：作品库（全部来自 shadertoy.db） -->
    <Border Grid.Column="0" Name="LibraryPanel" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBox Name="SearchBox"
                 DockPanel.Dock="Top"
                 Margin="8,8,8,4"
                 PlaceholderText="过滤作品（标题/作者/ID）"
                 TextChanged="OnSearchChanged" />

        <!-- buffer 分辨率三模式（Shadertoy 网页端的 viewport / fixed / scale 那三档） -->
        <!-- 初始选中项在代码里设：XAML 里写 SelectedIndex 会在控件还没构造完时触发 SelectionChanged -->
        <ComboBox Name="BufferModeBox"
                  DockPanel.Dock="Top"
                  Margin="8,0,8,6"
                  SelectionChanged="OnBufferModeChanged">
          <ComboBoxItem Content="buffer：跟随视口" />
          <ComboBoxItem Content="buffer：固定 1024×256" />
          <ComboBoxItem Content="buffer：视口 0.5×" />
        </ComboBox>

        <TextBlock Name="LibraryText"
                   DockPanel.Dock="Bottom"
                   Margin="8,4,8,8"
                   FontSize="11"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   Text="正在读取 shadertoy.db…" />

        <ListBox Name="ShaderList"
                 Margin="4,0"
                 SelectionChanged="OnShaderSelected">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="st:ShaderLibraryEntry">
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}"
                           ToolTip.Tip="{Binding Id}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Author}"
                           FontSize="11"
                           Opacity="0.6"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 右栏：GL 画面 + 底部信息条（pass / 错误都在这里） -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Bottom" Background="#161616" BorderBrush="#2A2A2A"
              BorderThickness="0,1,0,0" Padding="10,6">
        <StackPanel Classes="overlay" Spacing="1">
          <TextBlock Name="InfoShader" Text="正在读取作品库…" />
          <TextBlock Name="InfoTime" />
          <TextBlock Name="InfoSize" />
          <TextBlock Name="InfoPass" />
          <TextBlock Name="InfoAudio" />
          <TextBlock Name="InfoWarning" Foreground="#FFAB40" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <controls:ShaderToyControl Name="ShaderToyView" />
    </DockPanel>

  </Grid>

</UserControl>
