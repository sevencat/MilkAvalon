<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="MilkAvalon.Views.EditorWindow"
        Title="MilkAvalon 编辑"
        Icon="/Assets/milkdropsharp.png"
        Width="920" Height="820"
        MinWidth="520" MinHeight="360"
        Background="{DynamicResource MaterialBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowDecorations="BorderOnly">

  <DockPanel>
    <!--
      标题栏照抄主窗口那一套（misc.md §A7-3）：
        ExtendClientAreaToDecorationsHint + WindowDecorations="BorderOnly" → 客户区伸进标题栏，边框仍由系统画（保留拉伸）
        ElementRole="TitleBar" → 这块可拖动/双击最大化
        ElementRole="User"     → 里面的按钮自己收点击，否则会被当"拖动窗口"吃掉
    -->
    <Border DockPanel.Dock="Top" Height="40"
            Background="{DynamicResource MaterialToolBarBackgroundBrush}"
            Padding="12,0,8,0"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <Image Grid.Column="0" Source="avares://MilkAvalon/Assets/logo.png"
               Height="18" Margin="2,0,10,0"
               VerticalAlignment="Center" Stretch="Uniform" />

        <TextBlock Grid.Column="1" Name="CaptionText" Text="MilkAvalon 编辑"
                   FontSize="12" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                    chrome:WindowDecorationProperties.ElementRole="User">
          <Button Classes="caption" Name="MinimizeButton" Content="_" Click="OnMinimizeClick" ToolTip.Tip="最小化" />
          <Button Classes="caption" Name="MaximizeButton" Content="□" Click="OnMaximizeClick" ToolTip.Tip="最大化 / 还原" />
          <Button Classes="caption" Name="CloseButton" Content="✕" Click="OnCloseClick" ToolTip.Tip="关闭（面板收回右侧）" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 编辑面板本体（同一个实例从主窗口摘过来，见 MainWindow.PopOutEditor） -->
    <ContentControl Name="BodyHost" />
  </DockPanel>
</Window>
