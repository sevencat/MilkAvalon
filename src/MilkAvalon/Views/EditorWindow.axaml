<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:views="using:MilkAvalon.Views"
        x:Class="MilkAvalon.Views.EditorWindow"
        Title="{DynamicResource editorwindow.title}"
        Icon="/Assets/milkdropsharp.png"
        Width="1000" Height="780"
        MinWidth="520" MinHeight="360"
        Background="{DynamicResource MaterialBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowDecorations="BorderOnly">

  <DockPanel>
    <!--
      标题栏照抄主窗口那一套（misc.md §A7-3）：
        ExtendClientAreaToDecorationsHint + WindowDecorations="BorderOnly" → 客户区伸进标题栏，边框仍由系统画（保留拉伸）
        ElementRole="TitleBar" → 这块可拖动/双击最大化
        ElementRole="User"     → 里面的按钮自己收点击，否则会被当"拖动窗口"吃掉
    -->
    <Border DockPanel.Dock="Top" Height="40"
            Background="{DynamicResource MaterialToolBarBackgroundBrush}"
            Padding="12,0,8,0"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <Image Grid.Column="0" Source="avares://MilkAvalon/Assets/logo.png"
               Height="18" Margin="2,0,10,0"
               VerticalAlignment="Center" Stretch="Uniform" />

        <TextBlock Grid.Column="1" Name="CaptionText" Text="{DynamicResource editorwindow.title}"
                   FontSize="12" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                    chrome:WindowDecorationProperties.ElementRole="User">
          <Button Classes="caption" Name="MinimizeButton" Content="_" Click="OnMinimizeClick" ToolTip.Tip="{DynamicResource ui.caption.minimize}" />
          <Button Classes="caption" Name="MaximizeButton" Content="□" Click="OnMaximizeClick" ToolTip.Tip="{DynamicResource ui.caption.maximize}" />
          <Button Classes="caption" Name="CloseButton" Content="✕" Click="OnCloseClick" ToolTip.Tip="{DynamicResource editorwindow.close.tip}" />
        </StackPanel>
      </Grid>
    </Border>

    <!--
      P16：左编辑 + 右 AI，两栏并列（原来是"编辑停右侧 + AI 单独开窗"，看代码和看分析要来回切）。
      左栏放的是同一个 EditorPanel 实例（见 MainWindow.OpenEditorWindow），光标/滚动/未保存改动都跟着走。
    -->
    <!--
      列宽 4:3 是算出来的：左栏里还有 190px 的大纲，扣掉后代码区和右边 AI 正好一样宽
      （1360 × 4/7 − 194 ≈ 1360 × 3/7）。拖分隔条仍可自己调。
    -->
    <Grid ColumnDefinitions="4*,4,3*">
      <ContentControl Name="BodyHost" Grid.Column="0" />

      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                    Background="Transparent" />

      <views:AiChatPanel Name="AiPanel" Grid.Column="2" />
    </Grid>
  </DockPanel>
</Window>
