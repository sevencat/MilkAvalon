<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:MilkAvalon.Services"
             xmlns:edit="using:AvaloniaEdit"
             x:Class="MilkAvalon.Views.EditorPanel"
             IsVisible="False">

  <Border Background="{DynamicResource MaterialPaperBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1,0,0,0">
    <DockPanel>

      <!-- 标题栏：文件名（带 • 脏标记）+ 关闭 -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialToolBarBackgroundBrush}" Padding="10,8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Name="TitleText" Text="预设编辑" FontWeight="SemiBold" FontSize="13"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Name="PathText" Text="—" FontSize="11" Opacity="0.55"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Name="PopOutButton" Classes="toolbar" Content="弹出" Click="OnPopOutClick"
                  Padding="12,3" MinWidth="64" FontSize="12" VerticalAlignment="Center"
                  ToolTip.Tip="放进独立窗口，可以随便拉大（再点一次收回右侧）" />
          <Button Grid.Column="2" Classes="toolbar" Content="关闭" Click="OnCloseClick"
                  Padding="12,3" MinWidth="64" FontSize="12" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- 工具条：保存（写盘+重载）/ 应用（只重载）/ 还原 / 打开 -->
      <Grid DockPanel.Dock="Top" Margin="8,8,8,6" ColumnDefinitions="*,*,*,Auto" ColumnSpacing="6">
        <Button Name="SaveButton" Classes="toolbar" Content="保存" Click="OnSaveClick"
                FontSize="12" Padding="8,4" ToolTip.Tip="写回 .milk 并重载引擎（Ctrl+S）" />
        <Button Grid.Column="1" Name="ApplyButton" Classes="toolbar" Content="应用" Click="OnApplyClick"
                FontSize="12" Padding="8,4" ToolTip.Tip="不写盘，只把当前文本重载进引擎（试参数用）" />
        <Button Grid.Column="2" Name="RevertButton" Classes="toolbar" Content="还原" Click="OnRevertClick"
                FontSize="12" Padding="8,4" ToolTip.Tip="丢弃未保存的改动，重新从磁盘读取" />
        <Button Grid.Column="3" Name="OpenFileButton" Classes="toolbar" Content="打开…" Click="OnOpenFileClick"
                FontSize="12" Padding="8,4" ToolTip.Tip="编辑另一个 .milk 文件" />
      </Grid>

      <!-- 底部状态：光标下的名字提示（函数签名/参数含义）+ 保存结果 / 引擎告警 -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="0,1,0,0" Padding="8,5">
        <StackPanel Spacing="2">
          <TextBlock Name="HintText" FontSize="11" Foreground="#82AAFF"
                     TextTrimming="CharacterEllipsis" IsVisible="False" />
          <TextBlock Name="StatusText" Text="—" FontSize="11" Opacity="0.72"
                     TextWrapping="Wrap" MaxHeight="64" />
        </StackPanel>
      </Border>

      <!-- 主体：参数导航 + 原文编辑（.shaderx 没有参数，整列会收起来给 GLSL 腾地方） -->
      <Grid Name="BodyGrid" ColumnDefinitions="140,*">

        <Border Grid.Column="0" Name="ParamPane"
                BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="0,0,1,0">
          <DockPanel>
            <TextBox DockPanel.Dock="Top" Name="ParamFilter" Margin="6,0,6,4"
                     PlaceholderText="过滤参数" FontSize="11"
                     TextChanged="OnParamFilterChanged" />
            <TextBlock DockPanel.Dock="Bottom" Name="ParamCountText" Margin="8,4"
                       FontSize="10" Opacity="0.5" Text="—" />
            <ListBox Name="ParamList" Margin="2,0" SelectionChanged="OnParamSelected">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="services:MilkPresetEntry">
                  <StackPanel Spacing="0">
                    <TextBlock Text="{Binding Key}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Value}" FontSize="10" Opacity="0.42"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!--
          原文编辑器（AvaloniaEdit，plan.md D7）：行号 + 语法高亮 + 补全。
          文本仍然是唯一真相——高亮只是"看得清"，不改任何字符。
        -->
        <edit:TextEditor Grid.Column="1" Name="CodeBox"
                         ShowLineNumbers="True"
                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                         Background="{DynamicResource MaterialBackgroundBrush}"
                         Foreground="{DynamicResource MaterialBodyBrush}"
                         IsReadOnly="True"
                         WordWrap="False"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="OnCodeChanged" />
      </Grid>
    </DockPanel>
  </Border>

</UserControl>
