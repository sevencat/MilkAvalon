<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:MilkAvalon.Services"
             xmlns:ed="using:MilkAvalon.Editor"
             xmlns:edit="using:AvaloniaEdit"
             x:Class="MilkAvalon.Views.EditorPanel"
             IsVisible="False">

  <Border Background="{DynamicResource MaterialPaperBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1,0,0,0">
    <DockPanel>

      <!-- 标题栏：文件名（带 • 脏标记）；关窗口用窗口自己的 ✕（面板只活在独立窗口里，不需要别的按钮） -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialToolBarBackgroundBrush}" Padding="10,8">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Name="TitleText" Text="{DynamicResource editor.title}" FontWeight="SemiBold" FontSize="13"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Name="PathText" Text="—" FontSize="11" Opacity="0.55"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <!-- 工具条：保存（写盘+重载）/ 应用（只重载）/ 还原 / 打开；靠左排，不铺满（AI 分析在右栏，不放这儿） -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8,8,8,6">
        <Button Name="SaveButton" Classes="toolbar" Content="{DynamicResource editor.save}" Click="OnSaveClick"
                FontSize="12" Padding="14,4" ToolTip.Tip="{DynamicResource editor.save.tip}" />
        <Button Name="ApplyButton" Classes="toolbar" Content="{DynamicResource editor.apply}" Click="OnApplyClick"
                FontSize="12" Padding="14,4" ToolTip.Tip="{DynamicResource editor.apply.tip}" />
        <Button Name="RevertButton" Classes="toolbar" Content="{DynamicResource editor.revert}" Click="OnRevertClick"
                FontSize="12" Padding="14,4" ToolTip.Tip="{DynamicResource editor.revert.tip}" />
        <Button Name="OpenFileButton" Classes="toolbar" Content="{DynamicResource editor.open}" Click="OnOpenFileClick"
                FontSize="12" Padding="14,4" ToolTip.Tip="{DynamicResource editor.open.tip}" />
      </StackPanel>

      <!-- 底部状态：光标下的名字提示（函数签名/参数含义）+ 保存结果 / 引擎告警 -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="0,1,0,0" Padding="8,5">
        <StackPanel Spacing="2">
          <TextBlock Name="HintText" FontSize="11" Foreground="#82AAFF"
                     TextTrimming="CharacterEllipsis" IsVisible="False" />
          <TextBlock Name="StatusText" Text="—" FontSize="11" Opacity="0.72"
                     TextWrapping="Wrap" MaxHeight="64" />
        </StackPanel>
      </Border>

      <!-- 主体：大纲树（段/变量/函数）+ 原文编辑 -->
      <Grid Name="BodyGrid" ColumnDefinitions="190,4,*">

        <Border Grid.Column="0" Name="ParamPane"
                BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="0,0,1,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource editor.outline}" Margin="8,6,8,4"
                       FontSize="11" FontWeight="SemiBold" Opacity="0.75" />
            <TextBox DockPanel.Dock="Top" Name="ParamFilter" Margin="6,0,6,4"
                     PlaceholderText="{DynamicResource editor.filterOutline}" FontSize="11"
                     TextChanged="OnParamFilterChanged" />
            <TextBlock DockPanel.Dock="Bottom" Name="ParamCountText" Margin="8,4"
                       FontSize="10" Opacity="0.5" Text="—" />
            <!-- 段 → 段内的变量/函数；点节点跳到对应行（文本始终是唯一真相） -->
            <TreeView Name="OutlineTree" Margin="2,0" SelectionChanged="OnOutlineSelected">
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="ed:OutlineNode" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Glyph}" FontSize="11" Opacity="0.55" Width="10" />
                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="{Binding Weight}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.4"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </Border>

        <!-- 拖这条改大纲栏宽度（GLSL 长行要地方时往左收） -->
        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" Background="Transparent" />

        <!--
          原文编辑器（AvaloniaEdit，plan.md D7）：行号 + 语法高亮 + 补全。
          文本仍然是唯一真相——高亮只是"看得清"，不改任何字符。
        -->
        <edit:TextEditor Grid.Column="2" Name="CodeBox"
                         ShowLineNumbers="True"
                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                         Background="{DynamicResource MaterialBackgroundBrush}"
                         Foreground="{DynamicResource MaterialBodyBrush}"
                         IsReadOnly="True"
                         WordWrap="False"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="OnCodeChanged" />
      </Grid>
    </DockPanel>
  </Border>

</UserControl>
