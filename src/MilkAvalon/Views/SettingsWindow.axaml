<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="MilkAvalon.Views.SettingsWindow"
        Title="{DynamicResource settings.title}"
        Width="720" Height="520"
        MinWidth="560" MinHeight="360"
        Icon="/Assets/milkdropsharp.png"
        Background="{DynamicResource MaterialPaperBrush}"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        WindowDecorations="BorderOnly">

  <DockPanel>
    <!--
      自绘标题栏（和主窗口同一套做法）：
      系统标题栏由 DWM 绘制，浅色系统下是白条，和 Material 暗色主题完全对不上；
      DWM 的 DWMWA_USE_IMMERSIVE_DARK_MODE 在关掉 DWM 合成的机器上不生效，所以干脆自己画。
      ElementRole 的约定见 misc.md §A7-3：TitleBar 可拖动，子树里的按钮要标 User 才收得到点击。
      文案走 DynamicResource（P15）：设置窗口每次打开都重建，切语言后重开即是新语言。
    -->
    <Border DockPanel.Dock="Top" Name="CaptionBar"
            Background="{DynamicResource MaterialToolBarBackgroundBrush}"
            Padding="14,0,4,0"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="*,Auto" Height="36">
        <TextBlock Text="{DynamicResource settings.title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="caption" Name="CloseButton" Content="✕"
                Click="OnCaptionCloseClick"
                ToolTip.Tip="{DynamicResource settings.close.tip}"
                chrome:WindowDecorationProperties.ElementRole="User" />
      </Grid>
    </Border>

    <DockPanel Margin="16">
    <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <TextBlock Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.65" />
        <Button Classes="toolbar" Content="{DynamicResource settings.cancel}" Click="OnCancelClick" Padding="16,4" />
        <Button Classes="toolbar" Content="{DynamicResource settings.save}" Click="OnSaveClick" Padding="16,4" />
      </StackPanel>
    </Border>

    <!-- 关掉横向滚动：否则 `*` 列会退化成 Auto，文本框和提示语会把窗口撑出去（P7 踩到）。 -->
    <!-- 右侧留 12px：Material 的滚动条是覆盖式的，不留空会压在「浏览…」按钮上。 -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14" Margin="0,0,12,0">

        <TextBlock Text="{DynamicResource settings.section.dataRoot}" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="projectM" VerticalAlignment="Center" />
          <TextBox Grid.Row="0" Grid.Column="1" Name="ProjectMRootBox" />
          <Button Grid.Row="0" Grid.Column="2" Classes="toolbar" Content="{DynamicResource settings.browse}" Click="OnBrowseProjectMClick" Padding="12,4" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="ShaderToy" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Name="ShaderToyRootBox" />
          <Button Grid.Row="1" Grid.Column="2" Classes="toolbar" Content="{DynamicResource settings.browse}" Click="OnBrowseShaderToyClick" Padding="12,4" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource settings.label.milkx}" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" Name="MilkxRootBox" />
          <Button Grid.Row="2" Grid.Column="2" Classes="toolbar" Content="{DynamicResource settings.browse}" Click="OnBrowseMilkxClick" Padding="12,4" />
        </Grid>
        <TextBlock Name="RootHint" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                   Text="{DynamicResource settings.rootHint}" />

        <Separator Background="{DynamicResource MaterialDividerBrush}" />

        <TextBlock Text="{DynamicResource settings.section.render}" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
          <TextBlock Grid.Row="0" Text="projectM 网格" VerticalAlignment="Center" />
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Name="MeshWidthBox" Width="80" />
            <TextBlock Text="×" VerticalAlignment="Center" />
            <TextBox Name="MeshHeightBox" Width="80" />
            <TextBlock Text="{DynamicResource settings.mesh.hint}" FontSize="11" Opacity="0.55" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Grid.Row="1" Text="ShaderToy buffer" VerticalAlignment="Center" />
          <ComboBox Grid.Row="1" Grid.Column="1" Name="BufferModeBox" Width="260"
                    ToolTip.Tip="只有「跟随视口」与网页端默认一致。另两档会改 buffer 分辨率，按 iResolution 逐像素寻址 buffer 的作品（数据纹理类）会行列错位、偏黑。">
            <ComboBoxItem Content="{DynamicResource settings.buffer.viewport}" />
            <ComboBoxItem Content="{DynamicResource settings.buffer.fixed}" />
            <ComboBoxItem Content="{DynamicResource settings.buffer.half}" />
          </ComboBox>

          <TextBlock Grid.Row="2" Text="{DynamicResource settings.vsync}" VerticalAlignment="Center" />
          <CheckBox Grid.Row="2" Grid.Column="1" Name="VSyncBox" Content="{DynamicResource settings.vsync.note}" />

          <TextBlock Grid.Row="3" Text="{DynamicResource settings.scale}" VerticalAlignment="Center" />
          <ComboBox Grid.Row="3" Grid.Column="1" Name="UiScaleBox" Width="260">
            <ComboBoxItem Content="{DynamicResource settings.scale.system}" />
            <ComboBoxItem Content="125%" />
            <ComboBoxItem Content="150%" />
          </ComboBox>

          <TextBlock Grid.Row="4" Text="{DynamicResource settings.label.language}" VerticalAlignment="Center" />
          <ComboBox Grid.Row="4" Grid.Column="1" Name="LanguageBox" Width="260"
                    ToolTip.Tip="立即生效（语言本身不用重建页面）">
            <ComboBoxItem Content="{DynamicResource lang.zh}" />
            <ComboBoxItem Content="{DynamicResource lang.en}" />
          </ComboBox>
        </Grid>

        <Separator Background="{DynamicResource MaterialDividerBrush}" />

        <TextBlock Text="{DynamicResource settings.section.ai}" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
          <TextBlock Grid.Row="0" Text="{DynamicResource settings.ai.baseUrl}" VerticalAlignment="Center" />
          <TextBox Grid.Row="0" Grid.Column="1" Name="AiBaseUrlBox"
                   PlaceholderText="{DynamicResource settings.ai.baseUrlWatermark}" />

          <TextBlock Grid.Row="1" Text="{DynamicResource settings.ai.apiKey}" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Name="DeepSeekKeyBox" PasswordChar="●"
                   PlaceholderText="{DynamicResource settings.ai.keyPlaceholder}" />

          <TextBlock Grid.Row="2" Text="{DynamicResource settings.ai.model}" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" Name="DeepSeekModelBox"
                   PlaceholderText="{DynamicResource settings.ai.modelPlaceholder}" />
        </Grid>
        <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                   Text="{DynamicResource settings.ai.hint}" />

        <Separator Background="{DynamicResource MaterialDividerBrush}" />
        <TextBlock FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                   Text="{DynamicResource settings.bottomHint}" />
      </StackPanel>
    </ScrollViewer>
    </DockPanel>
  </DockPanel>

</Window>
