<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MilkAvalon.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="MilkAvalon.Views.MainWindow"
        Title="MilkAvalon"
        Icon="/Assets/milkdropsharp.png"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="520"
        Background="{DynamicResource MaterialBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="46"
        WindowDecorations="BorderOnly">

  <Window.Styles>
    <!-- 页签图标：Stroke 不吃 TextBlock.Foreground，得自己上色（深紫底 → 浅色描边） -->
    <Style Selector="Path.tabIcon">
      <Setter Property="Stroke" Value="{DynamicResource MaterialBodyLightBrush}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <!--
      工具栏按钮：颜色沿用 AppStyles 的紫色系（底 #5E35B1 / 悬停 #7E57C2 / 按下 #4527A0）。
      这里只管"分段组"的圆角：一组里第一个/最后一个才有外侧圆角，中间是直角，
      块与块之间 1px 的缝由外层 Border 的深紫底色透出来。
    -->
    <!-- 组内默认直角，拼起来才是一条连续的胶囊（不设 0 的话每块都是圆角，缝里会露出缺口） -->
    <Style Selector="Border#ToolBar Button.toolbar">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 单独一个按钮（☰）还是给它圆角 -->
    <Style Selector="Border#ToolBar Button#LibraryToggleButton">
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Border#ToolBar Button.toolbar.segFirst">
      <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>

    <Style Selector="Border#ToolBar Button.toolbar.segLast">
      <Setter Property="CornerRadius" Value="0,6,6,0" />
    </Style>

    <!-- 页面切换是 ListBox（Material 的 ChoiceChips）：芯片内边距收窄一点，别把工具栏撑高 -->
    <Style Selector="ListBox.ChoiceChips">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.ChoiceChips ListBoxItem">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#4527A0" />

      <!-- 别抢键盘焦点：否则方向键会在芯片之间切换页面，跟播放快捷键打架 -->
      <Setter Property="Focusable" Value="False" />

      <!--
        Material 的 ListBoxItem 模板不用控件的 CornerRadius（画出来是方角），
        这里换成和 AppStyles 里 Button.toolbar 一样的极简模板，圆角/底色才吃得进去。
      -->
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Chip"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="ListBox.ChoiceChips ListBoxItem:pointerover /template/ Border#PART_Chip">
      <Setter Property="Background" Value="#5E35B1" />
    </Style>

    <Style Selector="ListBox.ChoiceChips ListBoxItem:selected:pointerover /template/ Border#PART_Chip">
      <Setter Property="Background" Value="#9575CD" />
    </Style>

    <Style Selector="ListBox.ChoiceChips ListBoxItem:selected">
      <Setter Property="Background" Value="#7E57C2" />
    </Style>

    <!-- 图标里的"装饰细节"：细一档、淡一点，做主线条之外的点缀 -->
    <Style Selector="Path.tabIcon.accent">
      <Setter Property="StrokeThickness" Value="1.1" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="ListBox.ChoiceChips ListBoxItem:selected TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!--
      顶部工具栏同时充当**标题栏**。Avalonia 12 没有 WPF 的 WindowChrome，等价物是：
        ExtendClientAreaToDecorationsHint="True"  客户区伸进标题栏
        WindowDecorations="BorderOnly"            系统只画边框（保留拉伸边），标题栏自己画
        WindowDecorationProperties.ElementRole    标记哪个区域是标题栏 / 哪些按钮要自己收点击
      见 misc.md §A7-3（不标 User 的工具栏按钮会"点了没反应"）。
    -->
    <Border DockPanel.Dock="Top" Name="ToolBar" Background="{DynamicResource MaterialToolBarBackgroundBrush}" Padding="12,7,10,7"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <!--
        列含义：0 标题文字（仍属标题栏 → 可拖动）、1 工具栏按钮、2 空白（拖动/双击最大化）、3 窗口按钮。
        按钮区必须标 ElementRole="User"：父 Border 是 TitleBar（非客户区），不标的话整块被系统当
        "拖动窗口"吃掉，按钮点了没反应。窗口按钮那一栏一直是这么干的，所以它一直能点。
      -->
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
      <!-- 左上角 logo：milkavalon.jpg 是"黑底发光字"，已按反预乘抠成透明 logo.png，随工具栏高度缩放 -->
      <Image Grid.Column="0" Name="LogoImage"
             Source="avares://MilkAvalon/Assets/logo.png"
             Height="32" Margin="4,0,14,0"
             VerticalAlignment="Center"
             Stretch="Uniform" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                  chrome:WindowDecorationProperties.ElementRole="User">
        <Button Classes="toolbar" Name="LibraryToggleButton" Content="☰"
                Click="OnToggleLibraryClick" ToolTip.Tip="{DynamicResource ui.toolbar.library}" MinWidth="36" />

        <!-- 播放组：五个按钮拼成一段，只有两端有圆角，缝靠外层深紫底色透出来 -->
        <Border BorderBrush="#4527A0" BorderThickness="1" CornerRadius="7">
          <StackPanel Orientation="Horizontal" Spacing="1" Background="#4527A0">
            <Button Classes="toolbar segFirst" Name="PreviousButton" Content="◀◀"
                    Click="OnPreviousClick" ToolTip.Tip="{DynamicResource ui.toolbar.prev}" MinWidth="40" />
            <Button Classes="toolbar" Name="PauseButton" Content="▮▮"
                    Click="OnPauseClick" ToolTip.Tip="{DynamicResource ui.toolbar.pause}" MinWidth="40" />
            <Button Classes="toolbar" Name="NextButton" Content="▶▶"
                    Click="OnNextClick" ToolTip.Tip="{DynamicResource ui.toolbar.next}" MinWidth="40" />
            <Button Classes="toolbar" Name="RandomButton" Content="⇄"
                    Click="OnRandomClick" ToolTip.Tip="{DynamicResource ui.toolbar.random}" MinWidth="40" />
            <Button Classes="toolbar segLast" Name="ReloadButton" Content="⟳"
                    Click="OnReloadClick" ToolTip.Tip="{DynamicResource ui.toolbar.reload}" MinWidth="40" />
          </StackPanel>
        </Border>

        <!-- 工具组：编辑 / AI / 抓取 / 全屏 / 信息 / 设置 拼成一段 -->
        <Border BorderBrush="#4527A0" BorderThickness="1" CornerRadius="7">
          <StackPanel Orientation="Horizontal" Spacing="1" Background="#4527A0">
            <Button Classes="toolbar segFirst" Name="EditButton" Content="✎"
                    Click="OnEditClick" ToolTip.Tip="{DynamicResource ui.toolbar.edit}" MinWidth="40" />

            <Button Classes="toolbar" Name="CaptureButton" Content="⧉"
                    ToolTip.Tip="{DynamicResource ui.toolbar.capture}" MinWidth="40">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="{DynamicResource ui.menu.saveFrame}" Click="OnSaveFrameClick" />
                  <MenuItem Header="{DynamicResource ui.menu.grabSite}" Click="OnGrabShaderClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Classes="toolbar" Name="FullScreenButton" Content="⛶"
                    Click="OnFullScreenClick" ToolTip.Tip="{DynamicResource ui.toolbar.fullscreen}" MinWidth="40" />

            <Button Classes="toolbar" Name="InfoToggleButton" Content="▤"
                    Click="OnToggleInfoClick" ToolTip.Tip="{DynamicResource ui.toolbar.info}" MinWidth="40" />

            <Button Classes="toolbar segLast" Name="SettingsButton" Content="⚙"
                    Click="OnSettingsClick" ToolTip.Tip="{DynamicResource ui.toolbar.settings}" MinWidth="40" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!--
        页面切换：Material 的 ChoiceChips 单选列表（原来是一排按钮）。
        点哪个芯片就切哪页；再点当前页 = 强制重建（R2：整页销毁重建，靠 PointerPressed 自己抓）。
        必须标 ElementRole="User"：这块在标题栏区域内，不标的话点击会被系统当"拖动窗口"吃掉。
      -->
      <ListBox Grid.Column="2" Name="PageTabList" Classes="ChoiceChips"
               SelectionMode="Single" Focusable="False"
               HorizontalAlignment="Center" VerticalAlignment="Stretch"
               chrome:WindowDecorationProperties.ElementRole="User"
               SelectionChanged="OnPageTabSelectionChanged">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBoxItem ToolTip.Tip="{DynamicResource ui.tab.projectm.tip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Canvas Width="16" Height="16" VerticalAlignment="Center">
              <!-- 圆角框 + 三根音量柱 -->
              <Path Classes="tabIcon"
                    Data="M4.2,2.4 H11.8 A2.6,2.6 0 0 1 14.4,5 V11 A2.6,2.6 0 0 1 11.8,13.6 H4.2 A2.6,2.6 0 0 1 1.6,11 V5 A2.6,2.6 0 0 1 4.2,2.4 Z" />
              <Path Classes="tabIcon" Data="M5.2,10.4 V8.2 M8,10.4 V5.6 M10.8,10.4 V7" />
            </Canvas>
            <TextBlock Text="projectM" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>

        <!-- milkx（P12 / D1）：.milkx 脚本预设，播放链与 projectM 页共用 -->
        <ListBoxItem ToolTip.Tip="{DynamicResource ui.tab.milkx.tip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Canvas Width="16" Height="16" VerticalAlignment="Center">
              <!-- 奶滴 + 内侧高光 + 右上小星芒 -->
              <Path Classes="tabIcon"
                    Data="M8,1.6 C8,1.6 3.4,6.7 3.4,9.9 A4.6,4.6 0 0 0 12.6,9.9 C12.6,6.7 8,1.6 8,1.6 Z" />
              <Path Classes="tabIcon accent" Data="M6.1,9.8 A2,2 0 0 1 8,7.7" />
              <Path Classes="tabIcon accent" Data="M12.9,2.1 V4.3 M11.8,3.2 H14" />
            </Canvas>
            <TextBlock Text="milkx" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>

        <ListBoxItem ToolTip.Tip="{DynamicResource ui.tab.shadertoy.tip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Canvas Width="16" Height="16" VerticalAlignment="Center">
              <!-- 尖括号 + 中间斜杠 + 右上小星芒 -->
              <Path Classes="tabIcon" Data="M5.6,4.4 L2,8 L5.6,11.6" />
              <Path Classes="tabIcon" Data="M10.4,4.4 L14,8 L10.4,11.6" />
              <Path Classes="tabIcon accent" Data="M9.2,4 L6.8,12" />
              <Path Classes="tabIcon accent" Data="M13.1,2 V4 M12.1,3 H14.1" />
            </Canvas>
            <TextBlock Text="ShaderToy" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </ListBoxItem>
      </ListBox>

      <!--
        自绘窗口按钮。必须标 ElementRole="User"：标题栏区域默认是非客户区（点击会被系统吃掉），
        标了 User 的子树才会把点击还给 Avalonia。
      -->
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                  chrome:WindowDecorationProperties.ElementRole="User">
        <Button Classes="caption" Name="MinimizeButton" Content="_" Click="OnMinimizeClick" ToolTip.Tip="{DynamicResource ui.caption.minimize}" />
        <Button Classes="caption" Name="MaximizeButton" Content="□" Click="OnMaximizeClick" ToolTip.Tip="{DynamicResource ui.caption.maximize}" />
        <Button Classes="caption" Name="CloseButton" Content="✕" Click="OnCloseClick" ToolTip.Tip="{DynamicResource ui.caption.close}" />
      </StackPanel>
      </Grid>
    </Border>

    <!-- 状态栏 -->
    <Border DockPanel.Dock="Bottom" Name="StatusBar" Background="{DynamicResource MaterialToolBarBackgroundBrush}" Padding="12,6">
      <TextBlock Name="StatusText" Text="{DynamicResource ui.status.ready}" Opacity="0.6" FontSize="12" />
    </Border>

    <!--
      页面宿主：一次只活一个页面，切换时整页销毁重建（R2 / plan.md §6.4）。
      切换入口是工具栏右侧那两个按钮（原来的 TabControl 已去掉）。
    -->
    <Grid Name="PageArea">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Name="PageSurface">
        <ContentControl Name="PageHost" />

        <!-- 数据根缺失/为空时的兜底提示（P7）：居中浮层，不影响下面的引擎继续跑 -->
        <Border Name="EmptyState"
                IsVisible="False"
                Background="{DynamicResource MaterialCardBackgroundBrush}"
                BorderBrush="{DynamicResource MaterialDividerBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="24,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="12" MaxWidth="520">
            <TextBlock Text="{DynamicResource ui.empty.title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Name="EmptyStateText" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button Classes="toolbar" Content="{DynamicResource ui.empty.pickFolder}" Click="OnPickDataRootClick" Padding="16,4" />
              <Button Classes="toolbar" Content="{DynamicResource ui.empty.openSettings}" Click="OnSettingsClick" Padding="16,4" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>

</Window>
