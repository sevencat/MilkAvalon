<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MilkAvalon.Controls"
        xmlns:views="using:MilkAvalon.Views"
        x:Class="MilkAvalon.Views.MainWindow"
        Title="MilkAvalon"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="520"
        Background="#121212"
        WindowStartupLocation="CenterScreen">

  <DockPanel>
    <!-- 顶部工具栏：编辑/抓取是 P6/P7 的占位按钮（plan.md §6.3） -->
    <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="MilkAvalon" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Classes="toolbar" Name="PreviousButton" Content="上一个" Click="OnPreviousClick" />
        <Button Classes="toolbar" Name="PauseButton" Content="暂停" Click="OnPauseClick" />
        <Button Classes="toolbar" Name="NextButton" Content="下一个" Click="OnNextClick" />
        <Button Classes="toolbar" Name="RandomButton" Content="随机" Click="OnRandomClick" />
        <Button Classes="toolbar" Name="ReloadButton" Content="重载" Click="OnReloadClick" />
        <Separator Width="1" Margin="4,2" Background="#333333" />
        <Button Classes="toolbar" Name="EditButton" Content="编辑" IsEnabled="False" ToolTip.Tip="P10 实现" />
        <Button Classes="toolbar" Name="CaptureButton" Content="抓取" IsEnabled="False" ToolTip.Tip="P11 实现" />
      </StackPanel>
    </Border>

    <!-- 状态栏 -->
    <Border DockPanel.Dock="Bottom" Background="#1E1E1E" Padding="12,6">
      <TextBlock Name="StatusText" Text="就绪" Opacity="0.6" FontSize="12" />
    </Border>

    <!-- 两个页面：切 Tab 时整页销毁重建（R2，P5 实现） -->
    <TabControl Name="MainTabs" Padding="0">
      <TabItem Header="projectM">
        <views:ProjectMPage Name="ProjectM" />
      </TabItem>
      <TabItem Header="ShaderToy">
        <Grid>
          <!-- P4 接入前的占位：同时也是"GL 坏了用它对照"的探针控件 -->
          <controls:SpikeGlControl Name="Spike" />
          <TextBlock Text="ShaderToy 播放区（P4 接入）"
                     Foreground="#888888"
                     Margin="16"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom" />
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>

</Window>
