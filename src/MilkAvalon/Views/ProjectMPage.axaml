<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MilkAvalon.Controls"
             xmlns:services="using:MilkAvalon.Services"
             x:Class="MilkAvalon.Views.ProjectMPage">

  <Grid Name="RootGrid" ColumnDefinitions="300,*">

    <!-- 左栏：预设库（ListBox 默认虚拟化，9795 个也不卡） -->
    <Border Grid.Column="0" Name="LibraryPanel" Background="{DynamicResource MaterialPaperBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- 过滤框 + 重新扫描：清单平时来自 projectm\presets.index.json，只有点这个按钮才会重新扫盘 -->
        <Grid DockPanel.Dock="Top" Margin="8,8,8,4" ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Name="SearchBox"
                   PlaceholderText="{DynamicResource page.pm.filter}"
                   TextChanged="OnSearchChanged" />
          <Button Grid.Column="1" Classes="toolbar" Name="RescanButton" Content="{DynamicResource page.pm.rescan}"
                  Click="OnRescanClick" FontSize="12" Padding="12,4" MinWidth="84" Height="36"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{DynamicResource page.pm.rescan.tip}" />
        </Grid>

        <!-- 脚本页（.milkx）才显示：把老 .milk 转成 .milkx 导入本目录（D6/D7） -->
        <Grid Name="ImportPanel" DockPanel.Dock="Top" Margin="8,0,8,4"
              ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="False">
          <Button Classes="toolbar" Name="ImportFolderButton" Content="{DynamicResource page.pm.importFolder}"
                  Click="OnImportFolderClick" FontSize="12" Padding="8,4" Height="32"
                  ToolTip.Tip="{DynamicResource page.pm.importFolder.tip}" />
          <Button Grid.Column="1" Classes="toolbar" Name="ImportFilesButton" Content="{DynamicResource page.pm.importFiles}"
                  Click="OnImportFilesClick" FontSize="12" Padding="8,4" Height="32"
                  ToolTip.Tip="{DynamicResource page.pm.importFiles.tip}" />
        </Grid>

        <TextBlock Name="LibraryText"
                   DockPanel.Dock="Bottom"
                   Margin="8,4,8,8"
                   FontSize="11"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   Text="{DynamicResource page.pm.scanning}" />

        <ListBox Name="PresetList"
                 Margin="4,0"
                 SelectionChanged="OnPresetSelected">
          <ListBox.ItemTemplate>
            <!-- 只显示文件名：9795 个预设全是同一条长路径，显示全路径没法看 -->
            <DataTemplate x:DataType="services:PresetItem">
              <TextBlock Text="{Binding Name}"
                         ToolTip.Tip="{Binding Path}"
                         TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 右栏：GL 画面 + 底部信息条 -->
    <DockPanel Grid.Column="1">
      <!--
        信息条放底部而不是浮在画面上：实测"浮在 GL 控件上方的 Border"会被布局压到
        几十像素宽、文字被裁掉（misc.md §A3-2）；DockPanel 的停靠条则量得很正常。
      -->
      <Border Name="InfoBar" DockPanel.Dock="Bottom" Background="{DynamicResource MaterialPaperBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}"
              BorderThickness="0,1,0,0" Padding="10,6">
        <StackPanel Classes="overlay" Spacing="1">
          <TextBlock Name="InfoPreset" Text="{DynamicResource page.pm.initializing}" />
          <TextBlock Name="InfoProgress" />
          <TextBlock Name="InfoSize" />
          <TextBlock Name="InfoEngine" />
          <TextBlock Name="InfoAudio" />
          <TextBlock Name="InfoWarning" Foreground="#FFAB40" />
        </StackPanel>
      </Border>

      <controls:ProjectMControl Name="ProjectMView" />
    </DockPanel>

  </Grid>

</UserControl>
