  <!-- Page: ShaderToy -->
  <x:String x:Key="page.st.filter">Filter shaders (title/author/ID)</x:String>
  <x:String x:Key="page.st.buffer.tip">Anything but "follow viewport" changes the buffer resolution: shaders that address the buffer per pixel via iResolution (data-texture style) get misaligned and look dark.</x:String>
  <x:String x:Key="page.st.buffer.viewport">buffer: follow viewport</x:String>
  <x:String x:Key="page.st.buffer.fixed">buffer: fixed 1024×256</x:String>
  <x:String x:Key="page.st.buffer.half">buffer: viewport 0.5×</x:String>
