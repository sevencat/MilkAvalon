<!--
  English resource dictionary (P15 / milestone A).
  Key conventions: ui.* main window; settings.* settings window. Later windows continue with editor.* / ai.* / capture.*.
  Both dictionaries (zh-CN / en-US) must contain exactly the same keys — Localization.Apply swaps the whole book.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Main window: toolbar -->
  <x:String x:Key="ui.toolbar.library">Collapse / expand library</x:String>
  <x:String x:Key="ui.toolbar.prev">Previous</x:String>
  <x:String x:Key="ui.toolbar.pause">Pause / resume</x:String>
  <x:String x:Key="ui.toolbar.next">Next</x:String>
  <x:String x:Key="ui.toolbar.random">Random</x:String>
  <x:String x:Key="ui.toolbar.reload">Reload current</x:String>
  <x:String x:Key="ui.toolbar.edit">Edit current preset (.milk / .milkx / .shaderx)</x:String>
  <x:String x:Key="ui.toolbar.capture">Capture: save frame / grab shader from shadertoy</x:String>
  <x:String x:Key="ui.toolbar.fullscreen">Fullscreen (F11, Esc to exit)</x:String>
  <x:String x:Key="ui.toolbar.info">Show / hide the info bar (preset, progress, size, audio)</x:String>
  <x:String x:Key="ui.toolbar.settings">Settings</x:String>

  <!-- Main window: capture menu -->
  <x:String x:Key="ui.menu.saveFrame">Save current frame…</x:String>
  <x:String x:Key="ui.menu.grabSite">Grab shader from shadertoy…</x:String>

  <!-- Main window: tabs -->
  <x:String x:Key="ui.tab.projectm.tip">projectM (click again to rebuild this page)</x:String>
  <x:String x:Key="ui.tab.milkx.tip">milkx (.milkx script presets, click again to rebuild this page)</x:String>
  <x:String x:Key="ui.tab.shadertoy.tip">ShaderToy (click again to rebuild this page)</x:String>

  <!-- Main window: caption buttons / status bar / empty state -->
  <x:String x:Key="ui.caption.minimize">Minimize</x:String>
  <x:String x:Key="ui.caption.maximize">Maximize / restore</x:String>
  <x:String x:Key="ui.caption.close">Close</x:String>
  <x:String x:Key="ui.status.ready">Ready</x:String>
  <x:String x:Key="ui.empty.title">No data available</x:String>
  <x:String x:Key="ui.empty.pickFolder">Choose folder…</x:String>
  <x:String x:Key="ui.empty.openSettings">Open settings</x:String>

  <!-- Settings window: title & bottom -->
  <x:String x:Key="settings.title">Settings</x:String>
  <x:String x:Key="settings.close.tip">Close (same as cancel)</x:String>
  <x:String x:Key="settings.cancel">Cancel</x:String>
  <x:String x:Key="settings.save">Save</x:String>
  <x:String x:Key="settings.bottomHint">Takes effect immediately after saving: the current page is rebuilt (same as clicking its tab) without exiting playback. Config file: milkavalon.json next to the exe.</x:String>

  <!-- Settings window: data roots -->
  <x:String x:Key="settings.section.dataRoot">Data roots</x:String>
  <x:String x:Key="settings.label.milkx">Scripts (.milkx)</x:String>
  <x:String x:Key="settings.browse">Browse…</x:String>
  <x:String x:Key="settings.rootHint">The projectM root holds presets/ and textures/; the ShaderToy root holds presets/*.shaderx and media/; the scripts folder holds imported *.milkx. Leave blank to use the default folder next to the exe. Command line --projectm-data/--shadertoy-data/--milkx-data takes priority.</x:String>

  <!-- Settings window: rendering -->
  <x:String x:Key="settings.section.render">Rendering</x:String>
  <x:String x:Key="settings.mesh.hint">(the preset's nGridX/nGridY overrides it)</x:String>
  <x:String x:Key="settings.buffer.viewport">Follow viewport</x:String>
  <x:String x:Key="settings.buffer.fixed">Fixed 1024×256</x:String>
  <x:String x:Key="settings.buffer.half">Viewport 0.5×</x:String>
  <x:String x:Key="settings.vsync">VSync</x:String>
  <x:String x:Key="settings.vsync.note">On (currently driven by the Avalonia compositor, recorded only)</x:String>
  <x:String x:Key="settings.scale">UI scale</x:String>
  <x:String x:Key="settings.scale.system">Follow system</x:String>
  <x:String x:Key="settings.label.language">语言 / Language</x:String>
  <x:String x:Key="lang.zh">中文</x:String>
  <x:String x:Key="lang.en">English</x:String>

  <!-- Settings window: AI -->
  <x:String x:Key="settings.section.ai">AI analysis (OpenAI-compatible endpoint)</x:String>
  <x:String x:Key="settings.ai.baseUrl">Base URL</x:String>
  <x:String x:Key="settings.ai.baseUrlWatermark">https://api.deepseek.com/v1</x:String>
  <x:String x:Key="settings.ai.apiKey">API Key</x:String>
  <x:String x:Key="settings.ai.keyPlaceholder">Leave blank = read DEEPSEEK_API_KEY env var</x:String>
  <x:String x:Key="settings.ai.model">Model</x:String>
  <x:String x:Key="settings.ai.modelPlaceholder">deepseek-chat (or deepseek-reasoner)</x:String>
  <x:String x:Key="settings.ai.hint">Any OpenAI-compatible endpoint works (DeepSeek / local vLLM / a proxy…); a blank base URL = https://api.deepseek.com/v1. The key is written in plain text to milkavalon.json next to the exe; you may keep it only in an environment variable instead.</x:String>

  <!-- Settings window: C# side (via Localization.T / F) -->
  <x:String x:Key="settings.pick.projectM">Choose the projectM data root (a folder with presets/)</x:String>
  <x:String x:Key="settings.pick.shaderToy">Choose the ShaderToy data root (a folder with presets/*.shaderx)</x:String>
  <x:String x:Key="settings.pick.milkx">Choose the script preset folder (containing .milkx files)</x:String>
  <x:String x:Key="settings.error.mesh">Mesh size must be an integer between 8 and 256.</x:String>
  <x:String x:Key="settings.error.pickFolder">Failed to pick a folder: {0}</x:String>

  <!-- Editor panel: header / toolbar -->
  <x:String x:Key="editor.title">Preset editor</x:String>
  <x:String x:Key="editor.close">Close</x:String>
  <x:String x:Key="editor.outline">Outline</x:String>
  <x:String x:Key="editor.filterOutline">Filter sections, variables, functions</x:String>
  <x:String x:Key="editor.outline.summary">{0} sections · {1} variables · {2} functions</x:String>
  <x:String x:Key="editor.outline.params">{0} parameters</x:String>
  <x:String x:Key="editor.save">Save</x:String>
  <x:String x:Key="editor.save.tip">Write back and reload the engine (Ctrl+S)</x:String>
  <x:String x:Key="editor.apply">Apply</x:String>
  <x:String x:Key="editor.apply.tip">Reload the current text into the engine without writing to disk (handy for tweaking)</x:String>
  <x:String x:Key="editor.revert">Revert</x:String>
  <x:String x:Key="editor.revert.tip">Discard unsaved changes and re-read from disk</x:String>
  <x:String x:Key="editor.open">Open…</x:String>
  <x:String x:Key="editor.open.tip">Edit another preset file</x:String>

  <!-- Editor panel: C# side status & validation -->
  <x:String x:Key="editor.target.empty">Nothing editable yet: play a preset (.milk / .milkx) or pick a shader on the ShaderToy page first</x:String>
  <x:String x:Key="editor.target.unsupported">Only .milk / .milkx / .shaderx can be edited: {0}</x:String>
  <x:String x:Key="editor.dirtySwitch">Unsaved changes kept, still editing {0} (playback switched to {1})</x:String>
  <x:String x:Key="editor.loaded">Loaded {0}: {1} entries, {2} lines, {3}</x:String>
  <x:String x:Key="editor.loadFailed">Failed to open: {0}</x:String>
  <x:String x:Key="editor.fileMissing">File not found: {0}</x:String>
  <x:String x:Key="editor.loadedShaderx">Loaded {0}: {1} lines (.shaderx source; Ctrl+S saves and recompiles)</x:String>
  <x:String x:Key="editor.noFile">No file open</x:String>
  <x:String x:Key="editor.saveFailed">Failed to save: {0}</x:String>
  <x:String x:Key="editor.savedShaderx">Saved {0} ({1} lines)</x:String>
  <x:String x:Key="editor.savedShaderxApplied">, recompiled</x:String>
  <x:String x:Key="editor.err.empty">Content is empty</x:String>
  <x:String x:Key="editor.err.nul.shaderx">Content contains NUL characters; reading it back would be garbled</x:String>
  <x:String x:Key="editor.err.nul.milk">Content contains NUL characters; the engine would reject it as binary</x:String>
  <x:String x:Key="editor.err.noPass">No [shadertoy.&lt;role&gt;] section at all; this file cannot be played</x:String>
  <x:String x:Key="editor.err.noSection">No [section] at all; not a valid .milkx</x:String>
  <x:String x:Key="editor.err.noKeyValue">Not a single key=value line; the engine would reject this file</x:String>
  <x:String x:Key="editor.err.tooBig">Larger than {0} KiB; the engine would refuse to load it</x:String>
  <x:String x:Key="editor.saved">Saved {0} ({1} entries, {2})</x:String>
  <x:String x:Key="editor.savedAppliedSuffix">; the engine has reloaded</x:String>
  <x:String x:Key="editor.appliedShaderx">Current text recompiled (not written to disk; Ctrl+S to save)</x:String>
  <x:String x:Key="editor.applied">Current text applied to the engine (not written to disk; Ctrl+S to save)</x:String>
  <x:String x:Key="editor.discardWarning">Note: unsaved changes in {0} were discarded</x:String>
  <x:String x:Key="editor.openFile.title">Open .milk / .milkx / .shaderx</x:String>
  <x:String x:Key="editor.pick.all">All supported formats</x:String>
  <x:String x:Key="editor.pick.milk">MilkDrop presets</x:String>
  <x:String x:Key="editor.pick.shaderx">ShaderToy shaders</x:String>
  <x:String x:Key="editor.pickFailed">Failed to pick a file: {0}</x:String>

  <!-- Editor pop-out window -->
  <x:String x:Key="editorwindow.title">MilkAvalon editor</x:String>
  <x:String x:Key="editorwindow.close.tip">Close (the panel docks back to the main window)</x:String>

  <!-- AI analysis window -->
  <x:String x:Key="ai.title">AI analysis</x:String>
  <x:String x:Key="ai.prompt.placeholder">User prompt (editable)</x:String>
  <x:String x:Key="ai.analyze">Analyze</x:String>
  <x:String x:Key="ai.cancel">Cancel</x:String>
  <x:String x:Key="ai.cancel.tip">Abort this request (closing the window aborts too)</x:String>
  <x:String x:Key="ai.save">Save</x:String>
  <x:String x:Key="ai.save.tip">Save the analysis next to the script (&lt;filename&gt;.ai.md)</x:String>
  <x:String x:Key="ai.status.default">The system prompt is chosen by file type (shadertoy / milkdrop)</x:String>
  <x:String x:Key="ai.missingKey">No API key yet: fill it in under "Settings → AI analysis", or set the DEEPSEEK_API_KEY environment variable.</x:String>
  <x:String x:Key="ai.waiting">Requesting ({0})… waited {1:F0} s</x:String>
  <x:String x:Key="ai.receiving">Receiving ({0}): {1} chars, waited {2:F0} s</x:String>
  <x:String x:Key="ai.ready">Ready: {0} | {1} | script {2} chars. Press Enter or click "Analyze".</x:String>
  <x:String x:Key="ai.loadedSaved">Loaded the previous analysis: {0} ({1} chars). Click "Analyze" to request again.</x:String>
  <x:String x:Key="ai.cancelling">Cancelling…</x:String>
  <x:String x:Key="ai.noSavePath">No source file path; nowhere to save.</x:String>
  <x:String x:Key="ai.nothingToSave">No analysis result to save yet.</x:String>
  <x:String x:Key="ai.saved">Saved {0} ({1} chars).</x:String>
  <x:String x:Key="ai.saveFailed">Failed to save: {0}</x:String>
  <x:String x:Key="ai.noScript">No script content to analyze.</x:String>
  <x:String x:Key="ai.requesting">Requesting ({0}, streaming)… waited 0 s</x:String>
  <x:String x:Key="ai.doneTitle"> ({0} chars done)</x:String>
  <x:String x:Key="ai.done">Done: {0} chars. Click "Save" to write it next to the script.</x:String>
  <x:String x:Key="ai.cancelled">Cancelled.</x:String>
  <x:String x:Key="ai.timeout">Request timed out (waited {0:F0} s): the AI did not finish in time. Try a faster model (deepseek-chat) or a smaller script.</x:String>
  <x:String x:Key="ai.failed">Analysis failed: {0}</x:String>

  <!-- Capture window -->
  <x:String x:Key="capture.title">Grab a Shadertoy shader</x:String>
  <x:String x:Key="capture.back">Back</x:String>
  <x:String x:Key="capture.forward">Forward</x:String>
  <x:String x:Key="capture.open">Open</x:String>
