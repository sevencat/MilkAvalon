  <x:String x:Key="capture.grabCurrent.tip">Enabled when the page is shadertoy.com/view/&lt;id&gt;; the ID comes from the address bar</x:String>
  <x:String x:Key="capture.status.loading">Loading shadertoy.com…</x:String>
  <x:String x:Key="capture.status.root">Data root: {0} (only writes presets/*.shaderx and media/)</x:String>
  <x:String x:Key="capture.invalidId">Invalid ID: enter a short ID like flGyWc or a full view link.</x:String>
  <x:String x:Key="capture.opening">Opening {0}…</x:String>
  <x:String x:Key="capture.challengeTimeout">The site stayed on the bot-check page: finish the check in this window, then click "Grab this page".</x:String>
  <x:String x:Key="capture.pageReady">Page ready ({0}); requesting the project JSON…</x:String>
  <x:String x:Key="capture.interceptTimeout">Didn't capture the shader data: the page may not have finished loading, or the site changed.</x:String>
  <x:String x:Key="capture.waitingMedia">Waiting for the page to finish loading textures…</x:String>
  <x:String x:Key="capture.parseFailed">The fetched content is not a usable ShaderToy project: {0}</x:String>
  <x:String x:Key="capture.parsed">Parsed: {0} ({1} passes); fetching images…</x:String>
  <x:String x:Key="capture.summary">Saved {0} "{1}": {2} passes, images downloaded {3} / failed {4}{5} → {6}</x:String>
  <x:String x:Key="capture.summaryReplaced"> (old file replaced)</x:String>
  <x:String x:Key="capture.waitingPage">Site loading / waiting for the bot check… (if stuck, complete it in this window)</x:String>
  <x:String x:Key="capture.waitingChallenge">Still waiting for the bot check… (continues automatically once done)</x:String>
  <x:String x:Key="capture.navigating">Opening {0}</x:String>
  <x:String x:Key="capture.navDone">Page loaded. Click "Grab this page" on a shader page to save it.</x:String>
  <x:String x:Key="capture.navFailed">Page failed to load; retry or try another network.</x:String>
  <x:String x:Key="capture.invalidUrl">Invalid link: enter an address like https://www.shadertoy.com/view/&lt;id&gt;.</x:String>
  <x:String x:Key="capture.notShaderPage">Not a shader page (need https://www.shadertoy.com/view/&lt;id&gt;); open a shader first.</x:String>
  <x:String x:Key="capture.grabFailed">Grab failed: {0}</x:String>
  <x:String x:Key="capture.canGrab">Current page is {0}; click "Grab this page" to save it.</x:String>

  <!-- Main window: C# side status bar / messages -->
  <x:String x:Key="ui.status.loaded">Loaded {0}</x:String>
