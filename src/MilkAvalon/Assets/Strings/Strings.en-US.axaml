  <x:String x:Key="page.st.info.shader">Shader : {0}  [{1}]  {2}</x:String>
  <x:String x:Key="page.st.info.time">Time : {0:F2} s  frame {1}</x:String>
  <x:String x:Key="page.st.info.size">Size : {0}×{1}  {2} FPS</x:String>
